# ==============================================================================
# PolicyPulse Backend Environment Variables
# ==============================================================================
# Configure these variables in your Render Dashboard (Settings -> Environment)
# or in a local `.env` file (never commit actual `.env` files to git).
# ==============================================================================

# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Hosted MySQL Connection URL (Render / Aiven / Railway / PlanetScale / AWS RDS):
# Format: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# Example: mysql+pymysql://avnadmin:secretpassword@mysql-policy.aivencloud.com:12345/defaultdb
# (The backend also automatically converts mysql:// and mysql2:// to mysql+pymysql://)
DATABASE_URL=mysql+pymysql://root:your_secure_password@localhost:3306/financial_policy

# SQLite fallback for zero-config local development:
# DATABASE_URL=sqlite:///./financial_policy.db

# 2. CORS & FRONTEND ORIGIN CONFIGURATION
# ------------------------------------------------------------------------------
# Deployed Netlify frontend URL. Used to allow cross-origin requests securely.
# Can be a single URL or comma-separated list of URLs:
# Note: Netlify *.netlify.app domains are also automatically matched via regex.
FRONTEND_URL=https://your-policypulse-site.netlify.app

# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Strong secret key for signing JWT tokens (min 32 characters).
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-32-character-production-secret-key

# 4. SERVER PORT (Managed by Render)
# ------------------------------------------------------------------------------
# Render dynamically provides the PORT environment variable.
# Local development default is 8000.
PORT=8000

# 5. AI ENGINE CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# AI_MODE options:
#   - "deterministic_mock" (default, zero-cost, 100% deterministic RAG explanations)
#   - "live_llm" (requires LLM_API_KEY)
AI_MODE=deterministic_mock
LLM_API_KEY=
VECTOR_DATABASE_URL=

# 6. STORAGE & FILE UPLOADS
# ------------------------------------------------------------------------------
# Local directory or persistent mount path on Render (e.g. /var/data/uploads)
UPLOAD_DIR=uploads
