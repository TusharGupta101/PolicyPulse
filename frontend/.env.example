# ==============================================================================
# PolicyPulse Frontend Environment Variables
# ==============================================================================
# In production on Netlify: Set this in Site Configuration -> Environment Variables
# Set VITE_API_URL to your deployed Render backend web service URL (without trailing slash)
# Example:
# VITE_API_URL=https://policypulse-backend.onrender.com

# For local development:
# Leave blank to use the Vite reverse-proxy (/api -> http://127.0.0.1:8000),
# or explicitly set:
VITE_API_URL=http://127.0.0.1:8000
